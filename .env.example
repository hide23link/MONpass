# ─── 必須設定 ────────────────────────────────────────────────────────────────

# データベースファイルのパス
DB_PATH=./data/gakuensai.db

# JWT署名シークレット（32文字以上のランダム文字列を設定すること）
JWT_SECRET=change_this_to_a_long_random_secret_string

# 初期管理者アカウント（起動時に自動生成）
ADMIN_ID=admin
ADMIN_PASSWORD=change_this_password

# ─── ドメイン・URL設定 ────────────────────────────────────────────────────────

# QRコードに埋め込むドメイン（例: your-school-festival.example.com）
DOMAIN=localhost:8000

# ─── QR発行期間 ───────────────────────────────────────────────────────────────

# 生徒がQRを発行できる期間（ISO 8601形式）
ISSUE_START_DATE=2026-01-01
ISSUE_END_DATE=2026-12-31

# ─── ログイン失敗ロック設定 ───────────────────────────────────────────────────

# 何回連続失敗でロックするか
LOGIN_MAX_FAILURES=10

# ロック時間（分）
LOGIN_LOCKOUT_MINUTES=30
