{
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",
  "postCreateCommand": "pip install -r requirements.txt -r requirements-test.txt && playwright install chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "ms-python.black-formatter",
        "ms-vscode.live-server"
      ]
    }
  },
  "forwardPorts": [8000]
}
